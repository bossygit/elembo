# Variables d'environnement d'Elembo — copier en `.env.local` en développement,
# et renseigner dans Vercel (Settings → Environment Variables) en production.
# Ne JAMAIS committer un fichier rempli : ces valeurs sont des secrets.

# --- Côté navigateur ---------------------------------------------------------
# Depuis la migration Vercel, le site ET les routes /api/momo/* sont servis par la même
# application : laisser vide (même origine). Ne renseigner que pour pointer la boutique
# vers un service externe (test, bascule d'urgence). Équivalent : public/api-config.js.
# NEXT_PUBLIC_MOMO_API_URL=

# --- Supabase (staging / local) ----------------------------------------------
# Projet Supabase dédié aux tests. Ne jamais pointer ces variables vers la production.
# NEXT_PUBLIC_* sont visibles dans le navigateur ; SUPABASE_SERVICE_ROLE_KEY reste serveur.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_DEVIS=devis
SUPABASE_STORAGE_BUCKET_PRODUCTION=production

# Identifiant du projet de staging (non secret), utilisé par le garde-fou des scripts.
SUPABASE_STAGING_PROJECT_REF=
# Jeton personnel Supabase CLI (facultatif ; alternative à `supabase login`).
# Ne jamais le committer ni l'afficher. Portée : compte, pas projet.
# SUPABASE_ACCESS_TOKEN=

# --- Devis publics et sessions ------------------------------------------------
# Secrets HMAC serveur. Générer avec : openssl rand -base64 48
# Ne jamais les exposer avec NEXT_PUBLIC_*.
DEVIS_SESSION_SECRET=
DEVIS_OTP_SECRET=
DEVIS_OTP_TTL_SECONDS=600
DEVIS_OTP_MAX_ATTEMPTS=5

# Notification interne à la réception d'un devis (facultative).
DEVIS_NOTIFY_EMAIL=
DEVIS_EMAIL_FROM="Elembo <devis@example.com>"

# Fournisseur email facultatif. Sans RESEND_API_KEY, l'outbox conserve les messages
# A_ENVOYER et le back-office les signale ; aucune demande n'est perdue.
RESEND_API_KEY=
# Passerelle SMS facultative (adaptateur générique POST JSON). Sans URL/clé, le canal
# téléphone reste indisponible et l'OTP par email est utilisé s'il est configuré.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=

# --- Environnement MTN -------------------------------------------------------
# sandbox  : https://sandbox.momodeveloper.mtn.com (devise EUR imposée par MTN)
# mtncongo : https://proxy.momoapi.mtn.com (devise XAF — production)
MOMO_ENV=mtncongo

# Clés Collections (mail MTN du 27/10/2025). Portée : Production uniquement.
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=

# URL publique que MTN appellera. Elle voyage dans l'en-tête X-Callback-Url :
# la changer ne demande aucune démarche chez MTN.
MOMO_CALLBACK_URL=http://localhost:3000/api/momo/callback

# Origines autorisées en CORS (séparées par des virgules). Sur Vercel, site et API
# partagent la même origine : cette variable ne sert qu'aux clients externes.
APP_ORIGINS=http://localhost:3000
# URL publique canonique (métadonnées, sitemap et vérification d'origine).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stockage des transactions ----------------------------------------------
# Obligatoire en mode réel : une fonction serverless n'a pas de disque.
# Injectée automatiquement par l'intégration Redis de Vercel (Storage → Redis).
REDIS_URL=
# Variantes acceptées : API REST Upstash / Vercel KV (même code métier, autre transport).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Développement local uniquement -----------------------------------------
# Démonstration : paiements simulés, aucun appel MTN, aucun franc dépensé.
# INTERDIT en production : le service refuse MOMO_MOCK=1 avec MOMO_ENV=mtncongo, mais
# MOMO_MOCK=1 avec MOMO_ENV=sandbox simulerait des paiements. Ne jamais poser cette
# variable en Production ; elle est réservée à Preview / local.
# MOMO_MOCK=1
# Fichier de journal en local (au lieu de Redis), si l'on teste avec de vraies clés :
# MOMO_DATA_FILE=.data/transactions.json
# MOMO_MOCK_DELAY_MS=4000
# MOMO_SANDBOX_AMOUNT=10

# --- Ouverture du paiement en ligne ------------------------------------------
# Le paiement n'est proposé que pour un prix `valide` dans tarifs/grille.json.
# `NEXT_PUBLIC_PAIEMENT_TEST=1` rouvre le bouton pour des essais encadrés, même avec un
# prix de test. À réserver à Preview/local ; ne jamais laisser en Production publique.
# NEXT_PUBLIC_PAIEMENT_TEST=
# `MOMO_ALLOW_TEST_PRICES=1` est la dérogation SERVEUR correspondante : sans elle, l'API
# refuse un prix test/provisoire même si le bouton est forcé. Les deux sont nécessaires
# pour une recette de paiement réel sur un prix de test.
# MOMO_ALLOW_TEST_PRICES=

# --- Tâche planifiée ----------------------------------------------------------
# Secret partagé avec le cron Vercel (`vercel.json` → /api/momo/reconcilier). Sans lui,
# la route refuse (401). Vercel envoie `Authorization: Bearer $CRON_SECRET`.
# CRON_SECRET=

# --- Dossier de production (après paiement) -----------------------------------
# Archive privée des visuels et fiches reçus. `BLOB_STORE_ID` est injectée par l'intégration
# Vercel Blob ; un `BLOB_READ_WRITE_TOKEN` explicite fonctionne aussi (hors Vercel).
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=
# Jeton des routes atelier (liste et téléchargement des dossiers). Obligatoire en production.
ATELIER_TOKEN=
# Avis automatique à l'atelier. Facultatif : sans ces deux variables, le dossier est archivé et
# journalisé, mais personne n'est prévenu (`/api/sante` → atelier.notification = "absent").
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
