# Copier en `.env` et renseigner. Ce fichier n'est JAMAIS versionné.
#
# Environnement : « sandbox » (test) ou « mtncongo » (production Congo).
MOMO_ENV=sandbox

# Primary Key de la souscription « Collection » (profil du portail développeur).
MOMO_SUBSCRIPTION_KEY=

# Générés par `node scripts/provision-sandbox.mjs` — ne pas remplir à la main.
MOMO_API_USER=
MOMO_API_KEY=

# URL publique de callback déclarée à MTN (facultative : sans elle, le service interroge le statut).
# Celle communiquée à MTN pour Smart Vision :
MOMO_CALLBACK_URL=https://smartvision.cg/wp-json/momo/v1/callback

# Origines autorisées à appeler le service (CORS).
APP_ORIGINS=https://bossygit.github.io,http://localhost:3000

# Écoute
PORT=8787

# Mode démonstration locale (jamais avec MOMO_ENV=mtncongo)
# MOMO_MOCK=1
# MOMO_MOCK_DELAY_MS=4000
